# Copy to .env and adjust. Never commit .env.
#
# The values below are throwaway credentials for the LOCAL ShopSure demo store
# (demo-app/). They exist only in memory of the local server and protect nothing.
# For any shared or remote environment, supply real values through CI secrets.

# --- Target application ---
BASE_URL=http://127.0.0.1:4173
# Start the local demo store automatically before tests (set false for a remote target)
START_LOCAL_SERVER=true
PORT=4173

# --- Demo store seeded accounts (read by both the demo server and the tests) ---
STANDARD_USER=standard_user
STANDARD_USER_PASSWORD=local-demo-pass-1
LOCKED_USER=locked_user
LOCKED_USER_PASSWORD=local-demo-pass-2
ADMIN_USER=admin_user
ADMIN_USER_PASSWORD=local-demo-pass-3

# --- Test tuning ---
# Generous upper bound for API response-time assertions (milliseconds)
API_RESPONSE_TIME_LIMIT_MS=2000
# Seed for deterministic test data (leave empty for random data per run)
TEST_DATA_SEED=
# debug | info | warn | error
LOG_LEVEL=info

# --- Optional database validation (tests are skipped when unset) ---
# DATABASE_URL=postgres://shopsure:shopsure@127.0.0.1:5432/shopsure
